{
  "name": "entropi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0 --port 5199 --strictPort",
    "build": "vite build",
    "build:subscription-pilot": "vite build --config vite.subscription.config.js",
    "build:subscription-public": "vite build --config vite.subscription.public.config.js",
    "lint": "eslint .",
    "lint:subscription": "eslint src/subscription vite.subscription.public.config.js scripts/manage-subscription-shadow-tester.mjs scripts/manage-subscription-shadow-tester.test.mjs scripts/verify-subscription-public-build.mjs scripts/verify-subscription-final-approval.mjs scripts/verify-subscription-pilot-completion.mjs scripts/verify-subscription-shadow-backend.mjs scripts/verify-subscription-shadow-client.mjs scripts/verify-subscription-shadow-behavioral-qa.mjs scripts/verify-subscription-shadow-binding.mjs scripts/verify-subscription-shadow-binding.test.mjs",
    "preview": "vite preview",
    "test:subscription": "node --test src/subscription/__tests__/*.test.mjs scripts/manage-subscription-shadow-tester.test.mjs",
    "verify:subscription-separation": "node scripts/verify-subscription-separation.mjs",
    "verify:subscription-pilot-smoke": "node scripts/verify-subscription-pilot-smoke.mjs",
    "verify:subscription-pilot-completion": "node scripts/verify-subscription-pilot-completion.mjs",
    "verify:subscription-public-build": "npm run build:subscription-public && node scripts/verify-subscription-public-build.mjs",
    "test:subscription-shadow-binding": "node --test scripts/verify-subscription-shadow-binding.test.mjs",
    "verify:subscription-shadow-binding": "node scripts/verify-subscription-shadow-binding.mjs",
    "verify:subscription-shadow-backend": "node scripts/verify-subscription-shadow-backend.mjs",
    "verify:subscription-shadow-client": "node scripts/verify-subscription-shadow-client.mjs",
    "verify:subscription-shadow-behavioral-qa": "node scripts/verify-subscription-shadow-behavioral-qa.mjs",
    "verify:subscription-final-approval": "node scripts/verify-subscription-final-approval.mjs",
    "owner:subscription-shadow-tester": "node scripts/manage-subscription-shadow-tester.mjs",
    "test:subscription-shadow-tester-owner": "node --test scripts/manage-subscription-shadow-tester.test.mjs",
    "verify:subscription-shadow-readiness": "npm run verify:subscription-shadow-binding && npm run verify:subscription-shadow-backend && npm run verify:subscription-shadow-client && npm run test:subscription && npm run build:subscription-pilot && npm run verify:subscription-public-build",
    "verify:athlete-training-inputs": "node scripts/verify-athlete-training-inputs.mjs",
    "verify:athlete-onboarding": "node scripts/verify-athlete-onboarding.mjs",
    "verify:athlete-first-day-flow": "node scripts/verify-athlete-first-day-flow.mjs",
    "verify:coach-inbox-flow": "node scripts/verify-coach-inbox-flow.mjs",
    "verify:coach-priority": "node scripts/verify-coach-priority.mjs",
    "verify:videocoach-baseline-progress": "node scripts/verify-videocoach-baseline-progress.mjs",
    "verify:videocoach-feedback-quality": "node scripts/verify-videocoach-feedback-quality.mjs",
    "verify:videocoach-labels": "node scripts/verify-videocoach-labels.mjs",
    "verify:videocoach-variation-migration": "node scripts/verify-videocoach-variation-migration.mjs",
    "verify:n8n": "node n8n/verify-workflows.mjs",
    "preview:n8n-briefing": "node n8n/preview-coach-briefing.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
