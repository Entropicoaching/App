const data = $input.first().json;
const config = $('Configuration').first().json;
const messages = Array.isArray(data.unread_messages) ? data.unread_messages : [];
const videos = Array.isArray(data.video_drafts) ? data.video_drafts : [];
const signals = Array.isArray(data.training_signals) ? data.training_signals : [];
const briefingDate = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Europe/Copenhagen', year: 'numeric', month: '2-digit', day: '2-digit'
}).format(new Date());

const when = value => {
  if (!value) return 'tidspunkt ukendt';
  const date = new Date(value);
  if (!Number.isFinite(date.getTime())) return 'tidspunkt ukendt';
  return new Intl.DateTimeFormat('da-DK', {
    dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Copenhagen'
  }).format(date);
};
const timeValue = value => {
  const timestamp = value ? new Date(value).getTime() : Number.NaN;
  return Number.isFinite(timestamp) ? timestamp : Number.POSITIVE_INFINITY;
};

// ORDRE 370: en coachs rækkefølge, ikke kun "alerts først". Smerte, så
// fravær, så afvigelse fra plan, så beskeder/videoer, til sidst fremgang;
// inden for samme rang alert før context. Samme tabel som DETECTOR_RANK i
// src/coachBriefingRules.js (testet i src/coachBriefingRules.test.js).
const DETECTOR_RANK = { pain: 0, missed_sessions: 1, dropout: 1, rpe_drift: 2, stagnation: 2, data_conflict: 2, pr: 4 };
const MESSAGE_VIDEO_RANK = 3;

const rawTasks = [
  ...signals.map(item => {
    const detectorLabel = item.detector === 'dropout' ? 'Træningsmængde'
      : item.detector === 'stagnation' ? 'Udvikling'
        : item.detector === 'rpe_drift' ? 'RPE'
          : item.detector === 'pain' ? 'Smerte'
            : item.detector === 'missed_sessions' ? 'Fremmøde'
              : item.detector === 'data_conflict' ? 'Datatjek'
                : item.detector === 'pr' ? 'PR' : 'Træning';
    // Navnet står allerede i rækken; gentag det ikke foran fundet.
    const headline = String(item.headline || '');
    const namePrefix = `${item.athlete_name}: `;
    const finding = headline.startsWith(namePrefix) ? headline.slice(namePrefix.length) : headline;
    // v2-signaler bærer handlingen i metrics.action (og i detail). Fra et
    // v1-signal uden action vises detail som før, bare uden handlingslinje.
    const action = item.metrics && typeof item.metrics.action === 'string' ? item.metrics.action : null;
    const summaryParts = [finding, item.detail && item.detail !== action ? item.detail : null]
      .filter((value, index, all) => value && all.indexOf(value) === index);
    return {
      key: `signal-${item.athlete_id}-${item.detector}`,
      kind: 'signal', rank: (DETECTOR_RANK[item.detector] ?? 2) + (item.severity === 'alert' ? 0 : 0.5),
      athleteId: item.athlete_id,
      athleteName: item.athlete_name, label: detectorLabel,
      summary: summaryParts.join(' · ') || item.detail || 'Kræver et kig', action, timestamp: null,
      fingerprint: [item.athlete_id, item.detector, item.severity, item.headline, item.detail, item.metrics]
    };
  }),
  ...messages.map(item => ({
    key: `message-${item.athlete_id}-${item.track}`,
    kind: 'message', rank: MESSAGE_VIDEO_RANK, athleteId: item.athlete_id,
    athleteName: item.athlete_name,
    label: item.track === 'teknik' ? 'Teknik & løft' : 'Besked',
    summary: `${item.unread_count} ulæst${Number(item.unread_count) === 1 ? '' : 'e'} · senest ${when(item.latest_at)}`,
    timestamp: item.latest_at,
    fingerprint: [item.athlete_id, item.track, item.unread_count, item.latest_at]
  })),
  ...videos.map(item => {
    const lift = [item.lift, item.variation].filter(Boolean).join(' · ') || 'Videoanalyse';
    const load = item.load_kg == null ? '' : ` · ${item.load_kg} kg`;
    const reps = item.reps_count == null ? '' : ` · ${item.reps_count} reps`;
    return {
      key: `video-${item.id}`,
      kind: 'video', rank: MESSAGE_VIDEO_RANK, athleteId: item.athlete_id,
      athleteName: item.athlete_name, label: 'Videoanalyse',
      summary: `${lift}${load}${reps} · modtaget ${when(item.created_at)}`,
      timestamp: item.created_at,
      fingerprint: [item.id, item.athlete_id, item.created_at, item.lift, item.variation, item.load_kg, item.reps_count]
    };
  })
];

// Rang (se DETECTOR_RANK), derefter ældste besked/video. En stabil nøgle
// forhindrer, at samme opgave tæller dobbelt ved upstream-dubletter; ved
// dublet-nøgler (v1 gav én stagnationsrække pr. løft) vinder den vigtigste.
const byPriority = (left, right) => left.rank - right.rank
  || timeValue(left.timestamp) - timeValue(right.timestamp)
  || String(left.athleteName).localeCompare(String(right.athleteName), 'da')
  || left.key.localeCompare(right.key);
const tasks = [...new Map([...rawTasks].sort(byPriority).reverse().map(task => [task.key, task])).values()]
  .sort(byPriority);

// Sikkerhedsnet, ikke en nyhedsmail: en opgave nævnes højst én gang hver
// tredje dag. Manuelle/editor-previews springer denne undertrykkelse over,
// så det fulde, aktuelle billede altid kan inspiceres.
const REPEAT_SUPPRESSION_MS = 3 * 24 * 60 * 60 * 1000;
const state = $getWorkflowStaticData('global');
const mentionedAt = state.mentionedAt || {};
const now = Date.now();
const activeTasks = $execution.mode === 'test'
  ? tasks
  : tasks.filter(task => {
      const last = mentionedAt[task.key];
      return !last || now - new Date(last).getTime() >= REPEAT_SUPPRESSION_MS;
    });
const total = activeTasks.length;

// Returning no items ends the workflow: no empty fallback email, and no
// repeat of something already mailed about within the last three days.
if (total === 0) return [];

const esc = value => String(value ?? '')
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;')
  .replaceAll("'", '&#039;');
const counts = activeTasks.reduce((result, task) => {
  result[task.kind] = (result[task.kind] || 0) + 1;
  return result;
}, { signal: 0, message: 0, video: 0 });
const countSummary = [
  counts.signal ? `${counts.signal} signal${counts.signal === 1 ? '' : 'er'}` : '',
  counts.message ? `${counts.message} beskedspor` : '',
  counts.video ? `${counts.video} video${counts.video === 1 ? '' : 'er'}` : ''
].filter(Boolean).join(' · ');
// Static per-kind action phrase, neutral in tone. Signals carry their own,
// detector-specific action (metrics.action, ORDRE 370) and never get these.
const actionByKind = {
  message: 'Svar de ulæste beskeder',
  video: 'Gennemgå og giv feedback på løftet'
};
const taskRow = (task, index) => {
  const action = task.action || actionByKind[task.kind];
  const actionRow = action ? `<div style="font-size:13px;color:#c8923a;margin-top:4px">${esc(action)}</div>` : '';
  return `<div style="display:flex;gap:10px;padding:12px 0;border-top:1px solid #34342e"><div style="width:22px;height:22px;flex:0 0 22px;border:1px solid #57544c;color:#c8923a;text-align:center;line-height:22px;font-size:12px">${index + 1}</div><div><div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#7f7b72">${esc(task.label)}</div><div style="font-weight:650;color:#edeae2;margin-top:2px">${esc(task.athleteName)}</div><div style="font-size:13px;line-height:1.5;color:#aaa79f;margin-top:2px">${esc(task.summary)}</div>${actionRow}</div></div>`;
};
const first = activeTasks[0];
// Subject, countSummary and digestHash all read from the full `activeTasks` list
// above; only the HTML row list itself is capped here.
const VISIBLE_TASK_LIMIT = 5;
const visibleTasks = activeTasks.slice(0, VISIBLE_TASK_LIMIT);
const hiddenTaskCount = total - visibleTasks.length;
const moreRow = hiddenTaskCount > 0
  ? `<div style="padding:12px 0;border-top:1px solid #34342e;font-size:13px;color:#aaa79f">+${hiddenTaskCount} andre opgaver i appen</div>`
  : '';
const orderedRows = visibleTasks.map(taskRow).join('') + moreRow;

const appUrl = config.appUrl.replace(/\/$/, '');
// Emnet siger også hvem og hvad der står øverst, så mailen kan læses fra indbakken.
const subject = `Coach Briefing: ${total} ting har ventet et døgn · først: ${first.athleteName} (${first.label})`;
const html = `<div style="background:#141410;padding:28px 18px;font-family:Arial,sans-serif"><div style="max-width:620px;margin:auto;background:#1c1c18;border:1px solid #34342e;padding:24px"><div style="font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:#c8923a;margin-bottom:8px">Entropi Coach</div><h1 style="font-size:24px;line-height:1.2;color:#edeae2;margin:0 0 8px">Din coach-indbakke</h1><p style="color:#aaa79f;margin:0 0 20px;line-height:1.5">Kun åbne handlinger. Ingen videofiler eller beskedindhold er sendt gennem n8n.</p><div style="border-left:3px solid #c8923a;background:#24231d;padding:14px 16px;margin:0 0 22px"><div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#c8923a">Næste opgave</div><div style="font-size:18px;font-weight:700;color:#edeae2;margin-top:5px">${esc(first.athleteName)}</div><div style="font-size:13px;line-height:1.5;color:#b9b5ab;margin-top:3px">${esc(first.label)} · ${esc(first.summary)}</div>${first.action ? `<div style="font-size:13px;line-height:1.5;color:#c8923a;margin-top:4px">${esc(first.action)}</div>` : ''}</div><section style="margin:0 0 22px"><h2 style="font-size:17px;margin:0;color:#edeae2">Din rækkefølge <span style="color:#c8923a">${total}</span></h2><p style="font-size:12px;color:#77746d;margin:4px 0 8px">${esc(countSummary)} · smerte og fravær først, så afvigelse fra plan</p>${orderedRows}</section><a href="${esc(appUrl)}" style="display:inline-block;background:#c8923a;color:#141410;text-decoration:none;font-weight:700;padding:11px 16px;border-radius:3px">Åbn næste opgave i appen</a><p style="font-size:11px;color:#68665f;margin:22px 0 0">Automatisk morgenbriefing · Europe/Copenhagen</p></div></div>`;

const source = JSON.stringify({
  recipient: config.coachEmail,
  tasks: activeTasks.map(task => [task.key, task.fingerprint])
});
let hash = 2166136261;
for (let i = 0; i < source.length; i++) {
  hash ^= source.charCodeAt(i);
  hash = Math.imul(hash, 16777619);
}

return [{ json: {
  recipient: config.coachEmail, subject, html, total, briefingDate,
  priorityVersion: 'coach-order-v2', digestHash: `v2-${(hash >>> 0).toString(16)}`,
  taskKeys: activeTasks.map(task => task.key)
} }];
